      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAzw6zVDMG0KFuWIeQtg6mlasy-hghuZM4"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "62187f91-b5a2-4e06-808d-bf1052b97415"
      }
    },
    "owner": "homeintown.in",
    "plugins": [
      "expo-font"
    ]
  }
